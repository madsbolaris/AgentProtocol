{
  "name": "@microsoft/agents-typescript-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript workspace for Microsoft Agents Protocol packages",
  "workspaces": [
    "packages/*",
    "samples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "generate": "bash ../scripts/generation/generate-typescript.sh",
    "dev": "npm run dev --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
