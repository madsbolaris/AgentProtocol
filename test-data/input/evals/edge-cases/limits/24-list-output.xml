<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test list/array output validation" thread-id="eval-024" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>List 5 programming languages</text>
  </user>

  <expect name="list-validation">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <text>1. Python
2. JavaScript
3. Java
4. C++
5. Go</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains_python">{"substring": "Python", "caseSensitive": false}</judge>
    <judge agent="text_contains" as="contains_javascript">{"substring": "JavaScript", "caseSensitive": false}</judge>
    <assert>sem.passed &amp;&amp; contains_python.passed &amp;&amp; contains_javascript.passed &amp;&amp; size(sem.text.split('\n')) == 5</assert>
  </expect>
</thread>
