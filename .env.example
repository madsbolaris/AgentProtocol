# Microsoft Foundry Configuration
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT .env - IT CONTAINS SECRETS!

# Microsoft Foundry Endpoint
# Example: https://your-region-proj-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_ENDPOINT=https://your-foundry-endpoint.azure.com/api/projects/your-project

# Microsoft Foundry API Key/Secret
# Get this from your Azure AI Foundry portal
FOUNDRY_API_KEY=your-api-key-here

# Optional: Model deployment name
# Common values: gpt-4o-mini, gpt-4o, gpt-4-turbo
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini

# ============================================================================
# Telegram Notifications (for Claude Code stop hook)
# ============================================================================

# Telegram Bot Token
# To get this:
# 1. Message @BotFather on Telegram
# 2. Send /newbot and follow instructions
# 3. Copy the token it gives you (looks like: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Telegram Chat ID
# To get this:
# 1. Message your bot on Telegram
# 2. Visit: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# 3. Look for "chat":{"id": YOUR_CHAT_ID} in the response
# 4. Copy the chat ID number (can be negative for groups)
TELEGRAM_CHAT_ID=your-chat-id-here
