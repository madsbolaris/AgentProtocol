    <text>Provide detailed information</text>
  </user>

  <expect name="test-details-access">
    <agent message-id="ref-001" created-at="2026-02-09T00:00:01Z" agent-id="test-agent">
      <text>Here is the detailed response</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
