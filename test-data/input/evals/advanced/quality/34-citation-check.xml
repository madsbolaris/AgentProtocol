<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test citation and source references" thread-id="eval-034" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>Who invented the telephone? Cite your source.</text>
  </user>

  <expect name="cited-answer">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <text>Alexander Graham Bell invented the telephone in 1876. [Source: History.com]</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains_bell">{"substring": "Alexander Graham Bell", "caseSensitive": false}</judge>
    <judge agent="text_regex" as="citation">{"pattern": "\\[Source:|\\[\\d+\\]|\\(Source:", "flags": ""}</judge>
    <assert>sem.passed &amp;&amp; contains_bell.passed &amp;&amp; citation.passed</assert>
  </expect>
</thread>
