<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Complex tool call sequence" thread-id="eval-015" created-at="2026-02-08T00:00:00Z" status="active">
  <run maxSteps="20" timeoutMs="60000" />

  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>Book a flight from NYC to LAX on March 15th</text>
  </user>

  <expect name="search-flights">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <function-call call-id="call-001" name="search_flights">
        {"origin": "NYC", "destination": "LAX", "date": "2026-03-15"}
      </function-call>
    </agent>
    <judge agent="tool_call_match" as="tool_match" />
    <assert>tool_match.passed &amp;&amp; tool_match.function_name == "search_flights"</assert>
  </expect>

  <tool message-id="msg-002" created-at="2026-02-08T00:00:02Z">
    <function-result call-id="call-001" name="search_flights">
      {"flights": [{"id": "FL123", "price": 299}, {"id": "FL456", "price": 349}]}
    </function-result>
  </tool>

  <expect name="present-options">
    <agent message-id="ref-002" created-at="2026-02-08T00:00:03Z" agent-id="test-agent">
      <text>I found 2 flights. The cheapest is $299.</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains_299">{"substring": "299", "caseSensitive": false}</judge>
    <judge agent="text_contains" as="contains_2">{"substring": "2", "caseSensitive": false}</judge>
    <assert>sem.passed &amp;&amp; contains_299.passed &amp;&amp; contains_2.passed</assert>
  </expect>

  <user message-id="msg-003" created-at="2026-02-08T00:00:04Z">
    <text>Book the cheaper one</text>
  </user>

  <expect name="book-flight">
    <agent message-id="ref-003" created-at="2026-02-08T00:00:05Z" agent-id="test-agent">
      <function-call call-id="call-002" name="book_flight">
        {"flight_id": "FL123"}
      </function-call>
    </agent>
    <judge agent="tool_call_match" as="tool_match" />
    <assert>tool_match.passed &amp;&amp; tool_match.function_name == "book_flight"</assert>
  </expect>
</thread>
