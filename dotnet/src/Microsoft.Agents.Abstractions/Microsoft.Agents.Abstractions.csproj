<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Microsoft.Agents.Abstractions</PackageId>
    <RootNamespace>Microsoft.Agents.Abstractions</RootNamespace>
    <Description>Core abstractions and interfaces for the Microsoft Agents Framework</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Temporarily disabled to avoid circular dependency during development
  <Target Name="GenerateFromTypeSpec" BeforeTargets="BeforeBuild">
