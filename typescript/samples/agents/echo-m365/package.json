{
  "name": "typescript-echo-m365",
  "version": "1.0.0",
  "private": true,
  "description": "Agents echo bot sample with Agent Protocol support",
  "author": "Microsoft",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "scripts": {
    "prebuild": "echo 'Building...'",
    "build": "tsc --build",
    "prestart": "npm run build",
    "prestart:anon": "npm run build",
    "start:anon": "node ./dist/src/index.js",
    "start": "node --env-file .env ./dist/src/index.js",
