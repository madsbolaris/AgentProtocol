<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test with multimodal input" thread-id="eval-014" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>What's in this image?</text>
    <image url="https://example.com/cat.jpg" mime-type="image/jpeg" />
  </user>

  <expect name="image-description">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <text>I see a cat in the image.</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains">{"substring": "cat", "caseSensitive": false}</judge>
    <assert>sem.passed &amp;&amp; contains.passed</assert>
  </expect>
</thread>
