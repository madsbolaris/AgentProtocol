<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.agent.ai/messages/v1" elementFormDefault="qualified" targetNamespace="http://schemas.agent.ai/messages/v1" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="AITool">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="name" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="description" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="parameters" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="strict" type="xs:boolean" />
      <xs:element minOccurs="0" maxOccurs="1" name="endpoint" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="connection" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="scopes" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="lifecycle-hooks" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="requires-approval" type="xs:boolean" />
      <xs:element minOccurs="0" maxOccurs="1" name="metadata" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ToolLifecycleHooks">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="before-execute" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="after-execute" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="on-error" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="LifecycleHook">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="name" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="endpoint" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="connection" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="config" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="AutoToolChoice">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="kind" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RequiredToolChoice">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="kind" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="NoneToolChoice">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="kind" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="SpecificToolChoice">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="kind" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="tool-name" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="JSONSchema">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="properties" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="items" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="required" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="description" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="format" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="minimum" type="xs:double" />
      <xs:element minOccurs="0" maxOccurs="1" name="maximum" type="xs:double" />
      <xs:element minOccurs="0" maxOccurs="1" name="min-items" type="xs:int" />
      <xs:element minOccurs="0" maxOccurs="1" name="max-items" type="xs:int" />
      <xs:element minOccurs="0" maxOccurs="1" name="pattern" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
</xs:schema>