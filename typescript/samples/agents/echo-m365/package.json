    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testMatch='**/tests/**/*.test.ts'"
  },
  "dependencies": {
    "@microsoft/agents-hosting": "^1.2.3",
    "@microsoft/agents-hosting-express": "^1.2.3",
    "@microsoft/agents-protocol-hosting": "*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@microsoft/m365agentsplayground": "^0.2.16",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.15.18",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.3"
  },
  "keywords": []
}
