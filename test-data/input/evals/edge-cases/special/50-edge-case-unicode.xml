<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test Unicode and emoji handling" thread-id="eval-050" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>Say hello with emojis</text>
  </user>

  <expect name="emoji-response">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <text>👋 Hello! 😊</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains">{"substring": "Hello", "caseSensitive": false}</judge>
    <judge agent="text_regex" as="emoji">{"pattern": "[\\p{Emoji}]", "flags": "u"}</judge>
    <assert>sem.passed &amp;&amp; contains.passed &amp;&amp; emoji.passed</assert>
  </expect>
</thread>
