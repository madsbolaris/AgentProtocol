<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test audio content handling" thread-id="eval-032" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>What does this audio say?</text>
    <audio url="https://example.com/audio.mp3" mime-type="audio/mpeg" duration-ms="5000" />
  </user>

  <expect name="transcription">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <text>The audio says: "Hello, how are you today?"</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains">{"substring": "Hello", "caseSensitive": false}</judge>
    <assert>sem.passed &amp;&amp; contains.passed</assert>
  </expect>
</thread>
