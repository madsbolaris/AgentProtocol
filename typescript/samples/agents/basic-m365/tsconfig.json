{
  "compilerOptions": {
      "incremental": true,
      "lib": ["ES2021"],
      "types": ["node"],
      "target": "es2019",
      "module": "commonjs",
      "declaration": true,
      "sourceMap": true,
      "composite": true,
      "strict": true,
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "rootDir": ".",
      "outDir": "dist",
      "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"],
  "references": [
    { "path": "../../../packages/agents-protocol-abstractions" },
    { "path": "../../../packages/agents-protocol-hosting" }
  ]
}
