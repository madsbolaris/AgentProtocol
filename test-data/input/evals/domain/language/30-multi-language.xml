<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test multi-language support" thread-id="eval-030" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>Say 'hello' in Spanish, French, and German</text>
  </user>

  <expect name="multi-language">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <text>Spanish: Hola
French: Bonjour
German: Hallo</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains_hola">{"substring": "Hola", "caseSensitive": false}</judge>
    <judge agent="text_contains" as="contains_bonjour">{"substring": "Bonjour", "caseSensitive": false}</judge>
    <judge agent="text_contains" as="contains_hallo">{"substring": "Hallo", "caseSensitive": false}</judge>
    <assert>sem.passed &amp;&amp; contains_hola.passed &amp;&amp; contains_bonjour.passed &amp;&amp; contains_hallo.passed</assert>
  </expect>
</thread>
