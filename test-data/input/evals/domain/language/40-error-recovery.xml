<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test error recovery and retry" thread-id="eval-040" created-at="2026-02-08T00:00:00Z" status="active">
  <run maxSteps="10" />

  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>Get weather for invalid_city_123</text>
  </user>

  <expect name="error-tool-call">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <function-call call-id="call-001" name="get_weather">
        {"location": "invalid_city_123"}
      </function-call>
    </agent>
    <judge agent="tool_call_match" as="tool_match" />
    <assert>tool_match.passed &amp;&amp; tool_match.function_name == "get_weather"</assert>
  </expect>

  <tool message-id="msg-002" created-at="2026-02-08T00:00:02Z">
    <function-result call-id="call-001" name="get_weather" error="true">
      {"error": "City not found"}
    </function-result>
  </tool>

  <expect name="error-handled">
    <agent message-id="ref-002" created-at="2026-02-08T00:00:03Z" agent-id="test-agent">
      <text>I couldn't find weather information for that city. Please provide a valid city name.</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains">{"substring": "couldn't find", "caseSensitive": false}</judge>
    <assert>sem.passed &amp;&amp; contains.passed</assert>
  </expect>
</thread>
