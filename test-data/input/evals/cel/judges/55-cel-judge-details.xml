    <assert>sem.passed && sem.details.similarity_score > 0.8</assert>
  </expect>

  <expect name="test-combined-properties">
    <agent message-id="ref-002" created-at="2026-02-09T00:00:02Z" agent-id="test-agent">
      <text>Response with metrics</text>
    </agent>
    <judge agent="text_contains" as="content" />
    <judge agent="semantic_similarity" as="quality" />
    <!-- Test multiple property access -->
    <assert>content.passed && quality.score >= 0.7 && quality.details.similarity_score >= 0.7</assert>
  </expect>
