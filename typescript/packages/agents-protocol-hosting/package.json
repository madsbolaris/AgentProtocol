{
  "name": "@microsoft/agents-protocol-hosting",
  "version": "0.2.0",
  "description": "Hosting SDK for Microsoft Agents Protocol",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.mjs",
      "require": "./dist/storage/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.mjs",
      "require": "./dist/queue/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc -b --watch",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "agents",
    "protocol",
    "hosting",
    "sdk",
    "microsoft",
    "llm",
    "ai"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "dependencies": {
    "@microsoft/agents-protocol-abstractions": "*",
    "ajv": "^8.12.0",
    "openai": "^6.19.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.49.0",
    "ioredis": "^5.3.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@microsoft/agents-protocol-test-helpers": "*",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.0"
  }
}
