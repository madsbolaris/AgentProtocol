    <text>If a train travels 60 mph for 2.5 hours, how far does it go?</text>
  </user>

  <expect name="distance-calculation">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <thinking>Distance = Speed × Time = 60 mph × 2.5 hours = 150 miles</thinking>
      <text>The train travels 150 miles.</text>
    </agent>
    <judge agent="text_exact_match" as="match" />
    <judge agent="text_contains" as="contains">{"substring": "150", "caseSensitive": false}</judge>
    <assert>match.passed && contains.passed && has(match.message.reasoning)</assert>
  </expect>
