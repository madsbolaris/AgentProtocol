<thread desc="Multi-turn conversation with context" thread-id="eval-007" created-at="2026-02-08T00:00:00Z" status="active">
  <run maxSteps="10" />

  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>My name is Alice</text>
  </user>

  <expect name="acknowledgment">
