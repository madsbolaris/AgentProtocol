# Microsoft Foundry Configuration
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT .env - IT CONTAINS SECRETS!

# Microsoft Foundry Endpoint
# Example: https://your-region-proj-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_ENDPOINT=https://your-foundry-endpoint.azure.com/api/projects/your-project

# Microsoft Foundry API Key/Secret
# Get this from your Azure AI Foundry portal
FOUNDRY_API_KEY=your-api-key-here

# Optional: Model deployment name
# Common values: gpt-4o-mini, gpt-4o, gpt-4-turbo
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini
