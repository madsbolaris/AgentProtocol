{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synthesized Questions Schema",
  "description": "Schema for synthesized questions from all experts",
  "type": "object",
  "required": ["iteration", "questions"],
  "properties": {
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "description": "Current iteration number"
    },
    "questions": {
      "type": "array",
      "description": "Synthesized list of questions from all experts",
      "items": {
        "type": "object",
        "required": ["id", "question", "context", "asked_by"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the question"
          },
          "question": {
            "type": "string",
            "description": "The question text (potentially merged from multiple experts)"
          },
          "context": {
            "type": "string",
            "description": "Context explaining why this question matters"
          },
          "importance": {
            "enum": ["high", "medium", "low"],
            "description": "Importance level of the question"
          },
          "options": {
            "type": "array",
            "description": "2-3 clear options for answering the question",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 3
          },
          "selection_type": {
            "enum": ["radio", "checkbox"],
            "description": "radio for single choice, checkbox for multiple choice"
          },
          "asked_by": {
            "type": "array",
            "description": "List of experts who raised this question",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "references": {
            "type": "array",
            "description": "References from all experts who raised this question",
            "items": {
              "type": "object",
              "required": ["expert", "file", "context", "type"],
              "properties": {
                "expert": {
                  "type": "string",
                  "description": "Name of the expert who provided this reference"
                },
                "file": {
                  "type": "string",
                  "description": "File path with line reference (e.g., 'review-typescript-1.md#L45-L52')"
                },
                "excerpt": {
                  "type": "string",
                  "description": "Short quote from the referenced section (1-2 sentences)"
                },
                "context": {
                  "type": "string",
                  "description": "What this reference shows or why it matters"
                },
                "type": {
                  "enum": ["concern", "recommendation", "question"],
                  "description": "Type of reference"
                }
              }
            }
          }
        }
      }
    }
  }
}
