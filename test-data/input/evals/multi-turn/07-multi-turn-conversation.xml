  </expect>

  <user message-id="msg-002" created-at="2026-02-08T00:00:02Z">
    <text>What's my name?</text>
  </user>

  <expect name="name-recall">
    <agent message-id="ref-002" created-at="2026-02-08T00:00:03Z" agent-id="test-agent">
      <text>Your name is Alice.</text>
    </agent>
    <judge agent="text_contains" as="contains">["Alice"]</judge>
    <assert>contains.passed</assert>
  </expect>
</thread>
