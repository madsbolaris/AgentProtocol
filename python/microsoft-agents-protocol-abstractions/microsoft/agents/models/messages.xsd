<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.agent.ai/messages/v1" elementFormDefault="qualified" targetNamespace="http://schemas.agent.ai/messages/v1" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="EvalThread">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="elements" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="description" type="xs:string" use="optional" />
    <xs:attribute name="repeat" type="xs:int" use="optional" />
  </xs:complexType>
  <xs:element name="thread" type="tns:EvalThread" />
  <xs:complexType name="Expect">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="reference-output" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="judges" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="asserts" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="EvalRun">
    <xs:sequence />
    <xs:attribute name="max-steps" type="xs:int" use="optional" />
    <xs:attribute name="timeout-ms" type="xs:int" use="optional" />
  </xs:complexType>
  <xs:complexType name="Review">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="judges" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="asserts" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Judge">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="args" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="agent" type="xs:string" use="required" />
    <xs:attribute name="as" type="xs:string" use="required" />
    <xs:attribute name="scope" type="xs:string" use="optional" />
  </xs:complexType>
  <xs:complexType name="Assert">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="expression" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="min-pass-rate" type="xs:float" use="optional" />
  </xs:complexType>
  <xs:complexType name="JudgeResult">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="agent" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="as" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="passed" type="xs:boolean" />
      <xs:element minOccurs="1" maxOccurs="1" name="score" type="xs:float" />
      <xs:element minOccurs="1" maxOccurs="1" name="details" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="error" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="AssertResult">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="expression" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="passed" type="xs:boolean" />
      <xs:element minOccurs="1" maxOccurs="1" name="value" type="xs:boolean" />
      <xs:element minOccurs="0" maxOccurs="1" name="pass-rate" type="xs:float" />
      <xs:element minOccurs="0" maxOccurs="1" name="passes" type="xs:int" />
      <xs:element minOccurs="0" maxOccurs="1" name="runs" type="xs:int" />
      <xs:element minOccurs="0" maxOccurs="1" name="min-pass-rate" type="xs:float" />
      <xs:element minOccurs="0" maxOccurs="1" name="error" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="EvalResult">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="thread-id" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="description" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="passed" type="xs:boolean" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="runs" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="total-runs" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="passed-runs" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="failed-runs" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="total-asserts" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="passed-asserts" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="failed-asserts" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="avg-duration-ms" type="xs:float" />
      <xs:element minOccurs="1" maxOccurs="1" name="timestamp" type="xs:dateTime" />
      <xs:element minOccurs="1" maxOccurs="1" name="total-duration-ms" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="EvalRunResult">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="run-number" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="passed" type="xs:boolean" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="expects" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="review" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="duration-ms" type="xs:int" />
      <xs:element minOccurs="0" maxOccurs="1" name="error" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ExpectResult">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="name" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="passed" type="xs:boolean" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="judges" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="asserts" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ReviewResult">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="passed" type="xs:boolean" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="judges" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="unbounded" name="asserts" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ValidationError">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="code" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="message" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="line" type="xs:int" />
      <xs:element minOccurs="0" maxOccurs="1" name="element" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="LintError">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="message" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="line" type="xs:int" />
      <xs:element minOccurs="0" maxOccurs="1" name="element" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="fix" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="JudgeScope">
    <xs:restriction base="xs:string">
      <xs:enumeration value="last" />
      <xs:enumeration value="turn" />
      <xs:enumeration value="thread" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MatchType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="exact" />
      <xs:enumeration value="contains" />
      <xs:enumeration value="regex" />
      <xs:enumeration value="semantic" />
      <xs:enumeration value="jsonSubset" />
      <xs:enumeration value="jsonSchema" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>