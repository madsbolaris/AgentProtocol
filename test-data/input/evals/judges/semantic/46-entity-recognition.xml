<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test named entity recognition" thread-id="eval-046" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>List all the people and places mentioned: Steve Jobs founded Apple in Cupertino, California.</text>
  </user>

  <expect name="entities">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <text>People: Steve Jobs
Places: Cupertino, California</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains_jobs">{"substring": "Steve Jobs", "caseSensitive": false}</judge>
    <judge agent="text_contains" as="contains_cupertino">{"substring": "Cupertino", "caseSensitive": false}</judge>
    <judge agent="text_contains" as="contains_california">{"substring": "California", "caseSensitive": false}</judge>
    <assert>sem.passed &amp;&amp; contains_jobs.passed &amp;&amp; contains_cupertino.passed &amp;&amp; contains_california.passed</assert>
  </expect>
</thread>
