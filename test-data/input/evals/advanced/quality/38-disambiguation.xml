<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Test disambiguation of ambiguous queries" thread-id="eval-038" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>Tell me about Apple</text>
  </user>

  <expect name="clarification">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <text>Are you asking about Apple the fruit or Apple the technology company?</text>
    </agent>
    <judge agent="semantic_similarity" as="sem" />
    <judge agent="text_contains" as="contains">{"substring": "?", "caseSensitive": false}</judge>
    <assert>sem.passed &amp;&amp; contains.passed</assert>
  </expect>
</thread>
