<?xml version="1.0" encoding="UTF-8"?>
<thread desc="Expectation with tool call" thread-id="eval-004" created-at="2026-02-08T00:00:00Z" status="active">
  <user message-id="msg-001" created-at="2026-02-08T00:00:00Z">
    <text>What's the weather in San Francisco?</text>
  </user>

  <expect name="weather-tool-call">
    <agent message-id="ref-001" created-at="2026-02-08T00:00:01Z" agent-id="test-agent">
      <function-call call-id="call-001" name="get_weather">
        {"location": "San Francisco", "units": "fahrenheit"}
      </function-call>
    </agent>
    <judge agent="tool_call_match" as="tool">{"location": "San Francisco"}</judge>
    <assert>tool.passed</assert>
  </expect>

  <tool message-id="msg-002" created-at="2026-02-08T00:00:02Z">
    <function-result call-id="call-001" name="get_weather">
      {"temperature": 65, "conditions": "sunny"}
    </function-result>
  </tool>

  <expect name="weather-response">
    <agent message-id="ref-002" created-at="2026-02-08T00:00:03Z" agent-id="test-agent">
      <text>It's 65°F and sunny in San Francisco.</text>
    </agent>
    <judge agent="text_contains" as="contains">["65", "sunny"]</judge>
    <assert>contains.passed</assert>
  </expect>
</thread>
